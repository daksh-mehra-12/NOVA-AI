# ==============================================================================
# NOVA AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and populate your API credentials.

# OpenWeatherMap API Key (Get at: https://openweathermap.org/api)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# News Data API / NewsAPI Key (Get at: https://newsdata.io or https://newsapi.org)
NEWS_API_KEY=YOUR_NEWS_API_KEY

# SMTP Email Credentials (For Gmail, use App Passwords)
EMAIL_USER=YOUR_EMAIL@gmail.com
EMAIL_PASSWORD=YOUR_APP_PASSWORD
